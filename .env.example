# Copy to .env.local for local development (git-ignored). On Vercel, set these as project environment variables.
# Never commit real values. docs/INSTALL.md explains each one.

APP_URL=http://localhost:3000
APP_NAME=Betdesk
TIME_ZONE=UTC

# Postgres. Locally, leave it empty to use PGlite in .data/pglite.
DATABASE_URL=

# openssl rand -hex 32
SESSION_SECRET=
CRON_SECRET=

# Google OAuth client (web application), redirect URI: <APP_URL>/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Who may sign in (comma-separated)
ALLOWED_DOMAINS=example.com
ALLOWED_EMAILS=
ADMIN_EMAILS=you@example.com

ANTHROPIC_API_KEY=

# Optional: Jira Cloud
JIRA_BASE_URL=
JIRA_SITE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=

# Optional: coding agent (fine-grained token: Issues read/write, Pull requests read)
GITHUB_TOKEN=
GITHUB_AGENT_LABEL=betdesk-agent

# Local development only: sign in at /dev/login as this address, without Google.
DEV_LOGIN_EMAIL=
